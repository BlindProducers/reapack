    v8.gr_try(8); v9.gr_try(9); v10.gr_try(10); v11.gr_try(11); v12.gr_try(12); v13.gr_try(13); v14.gr_try(14); v15.gr_try(15);
  );
  gcount = max(gcount, 0) + gint * (0.5 + rnd01());
);
gfs += (gft - gfs) * KS;
gfl = gsl * gfs; gfr = gsr * gfs;

