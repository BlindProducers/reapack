genv += (t - genv) * KENV;
gbase[gw] = 0.70710678 * (p_gsrc ? inl + inr : revl + revr);
gw = (gw + 1) & GMSK;
gsl = 0; gsr = 0;
gactive > 0 ? (
  v0.gr_run(); v1.gr_run(); v2.gr_run(); v3.gr_run(); v4.gr_run(); v5.gr_run(); v6.gr_run(); v7.gr_run();
  v8.gr_run(); v9.gr_run(); v10.gr_run(); v11.gr_run(); v12.gr_run(); v13.gr_run(); v14.gr_run(); v15.gr_run();
);
