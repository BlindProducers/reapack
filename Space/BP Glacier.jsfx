l8.tk_damp(); l9.tk_damp(); l10.tk_damp(); l11.tk_damp(); l12.tk_damp(); l13.tk_damp(); l14.tk_damp(); l15.tk_damp();
t = l0.y; l0.y = t + l1.y; l1.y = t - l1.y; t = l2.y; l2.y = t + l3.y; l3.y = t - l3.y;
t = l4.y; l4.y = t + l5.y; l5.y = t - l5.y; t = l6.y; l6.y = t + l7.y; l7.y = t - l7.y;
t = l8.y; l8.y = t + l9.y; l9.y = t - l9.y; t = l10.y; l10.y = t + l11.y; l11.y = t - l11.y;
t = l12.y; l12.y = t + l13.y; l13.y = t - l13.y; t = l14.y; l14.y = t + l15.y; l15.y = t - l15.y;
t = l0.y; l0.y = t + l2.y; l2.y = t - l2.y; t = l1.y; l1.y = t + l3.y; l3.y = t - l3.y;
t = l4.y; l4.y = t + l6.y; l6.y = t - l6.y; t = l5.y; l5.y = t + l7.y; l7.y = t - l7.y;
t = l8.y; l8.y = t + l10.y; l10.y = t - l10.y; t = l9.y; l9.y = t + l11.y; l11.y = t - l11.y;
