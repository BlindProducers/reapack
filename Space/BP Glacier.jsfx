gdg += gdi;
a0 *= t; a1 *= t; a2 *= t; a3 *= t; a4 *= t; a5 *= t; a6 *= t; a7 *= t;
l0.tk_write(a0); l1.tk_write(a1); l2.tk_write(a2); l3.tk_write(a3); l4.tk_write(a4); l5.tk_write(a5); l6.tk_write(a6); l7.tk_write(a7);
l8.tk_write(-a0); l9.tk_write(-a1); l10.tk_write(-a2); l11.tk_write(-a3); l12.tk_write(-a4); l13.tk_write(-a5); l14.tk_write(-a6); l15.tk_write(-a7);
wpos = (wpos + 1) & TMSK;
sf += sfi; mdep += mdi; ig += igi; oc += oci;

// grains
