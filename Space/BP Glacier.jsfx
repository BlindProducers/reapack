a0 = d20.df_run(a0); a1 = d21.df_run(a1); a2 = d22.df_run(a2); a3 = d23.df_run(a3);
a4 = d24.df_run(a4); a5 = d25.df_run(a5); a6 = d26.df_run(a6); a7 = d27.df_run(a7); had8();
a0 = d30.df_run(a0); a1 = d31.df_run(a1); a2 = d32.df_run(a2); a3 = d33.df_run(a3);
a4 = d34.df_run(a4); a5 = d35.df_run(a5); a6 = d36.df_run(a6); a7 = d37.df_run(a7); had8();
dpos = (dpos + 1) & DMSK;

// tank
l0.tk_read(); l1.tk_read(); l2.tk_read(); l3.tk_read(); l4.tk_read(); l5.tk_read(); l6.tk_read(); l7.tk_read();
l8.tk_read(); l9.tk_read(); l10.tk_read(); l11.tk_read(); l12.tk_read(); l13.tk_read(); l14.tk_read(); l15.tk_read();
revl = oc * (l0.x - l1.x + l2.x - l3.x + l4.x - l5.x + l6.x - l7.x + l8.x - l9.x + l10.x - l11.x + l12.x - l13.x + l14.x - l15.x);
revr = oc * (l0.x + l1.x - l2.x - l3.x + l4.x + l5.x - l6.x - l7.x + l8.x + l9.x - l10.x - l11.x + l12.x + l13.x - l14.x - l15.x);
