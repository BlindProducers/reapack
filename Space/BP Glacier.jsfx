rvg += (rvt - rvg) * KS; grg += (grt - grg) * KS; wd += (wdt - wd) * KS;
wl = revl * rvg + gsl * grg; wr = revr * rvg + gsr * grg;
t = 0.5 * (wl + wr); u = 0.5 * (wl - wr) * wd; wl = t + u; wr = t - u;
wl = lpl.svf_lp(hpl.svf_hp(wl)); wr = lpr.svf_lp(hpr.svf_hp(wr));
ha1 += hai1; ha2 += hai2; ha3 += hai3; la1 += lai1; la2 += lai2; la3 += lai3;

dgn += (dgt - dgn) * KS; wgn += (wgt - wgn) * KS; ogn += (ogt - ogn) * KS;
spl0 = ogn * (dgn * inl + wgn * wl);
spl1 = ogn * (dgn * inr + wgn * wr);
