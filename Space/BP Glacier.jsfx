gft = p_grains == 1 ? p_gfb / 100 * min(1, t * t) : 0;
first ? ( dgn = dgt; wgn = wgt; ogn = ogt; wd = wdt; rvg = rvt; grg = grt; gfs = gft; );

glen = p_gsize / 1000 * srate;
gspr = p_gspray / 1000 * srate;
gint = srate / p_gdens;
